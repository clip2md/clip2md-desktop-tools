    "verify": "npm run typecheck && npm test && npm run lint && npm run build && node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "acorn": "8.19.0",
    "turndown": "7.2.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "18.19.130",
    "@types/turndown": "5.0.6",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "26.1.0",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "moment": "2.31.0"
  }
